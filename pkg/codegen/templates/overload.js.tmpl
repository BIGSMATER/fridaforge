{{if eq .FridaVersion "17"}}// 此脚本使用 Java bridge，需先通过 frida-compile 编译：
//   npm install -g frida-compile
//   frida-compile script.js -o compiled.js
//   frida -U -f com.app -l compiled.js
{{end}}    var TargetClass = Java.use("{{.ClassName}}");
{{if .MethodSignature}}
    TargetClass.{{.MethodName}}.overload('{{.MethodSignature}}').implementation = function() {
{{else}}
    TargetClass.{{.MethodName}}.overload().implementation = function() {
{{end}}
        console.log("[+] {{.ClassName}}.{{.MethodName}} called");
        send(JSON.stringify({event: "enter", class: "{{.ClassName}}", method: "{{.MethodName}}", args: Array.prototype.slice.call(arguments)}));
        var result = this.{{.MethodName}}.apply(this, arguments);
        send(JSON.stringify({event: "leave", class: "{{.ClassName}}", method: "{{.MethodName}}", result: result}));
        return result;
    };
