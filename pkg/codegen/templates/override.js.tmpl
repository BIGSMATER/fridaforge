{{if .MethodSignature}}
    TargetClass.{{.MethodName}}.overload('{{.MethodSignature}}').implementation = function() {
{{else}}
    TargetClass.{{.MethodName}}.overload().implementation = function() {
{{end}}
        console.log("[+] {{.ClassName}}.{{.MethodName}} hooked (override)");
        send(JSON.stringify({event: "override", class: "{{.ClassName}}", method: "{{.MethodName}}", args: Array.prototype.slice.call(arguments)}));
        // 完全替换原方法实现，不调用原方法。在此返回自定义值。
    };
